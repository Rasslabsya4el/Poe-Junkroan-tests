{
  "permissions": {
    "allow": [
      "CronCreate"
    ],
    "deny": [
      "mcp__ccd_session_mgmt__clear_session",
      "CronDelete",
      "DesignSync",
      "NotebookEdit",
      "ScheduleWakeup",
      "Workflow",
      "mcp__claude_ai_Claude_Docs__batch",
      "mcp__claude_ai_Claude_Docs__create",
      "mcp__claude_ai_Claude_Docs__delete",
      "mcp__claude_ai_Claude_Docs__export",
      "mcp__claude_ai_Claude_Docs__guide",
      "mcp__claude_ai_Claude_Docs__query",
      "mcp__claude_ai_Claude_Docs__read",
      "mcp__claude_ai_Claude_Docs__update",
      "mcp__scheduled-tasks__create_scheduled_task",
      "mcp__scheduled-tasks__delete_scheduled_task",
      "mcp__scheduled-tasks__list_scheduled_tasks",
      "mcp__scheduled-tasks__list_task_runs",
      "mcp__scheduled-tasks__run_scheduled_task",
      "mcp__scheduled-tasks__update_scheduled_task",
      "mcp__ccd_session_mgmt__set_session_permission_mode",
      "mcp__ccd_directory",
      "mcp__ccd_host",
      "mcp__ccd_pr",
      "mcp__ccd_sidebar",
      "mcp__ccd_view",
      "mcp__ccd_window",
      "mcp__mcp-registry",
      "mcp__scheduled-tasks",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean*)",
      "Bash(git worktree remove*)",
      "Bash(gh repo delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh auth token*)",
      "Bash(format *)",
      "Bash(diskpart*)",
      "Bash(shutdown*)",
      "Bash(bcdedit*)",
      "mcp__ccd_session_mgmt__set_session_title"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/tracker_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/permission_guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/agent_role_prefix.py\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/brain_read_nudge.py\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/brain_read_nudge.py\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/refuse_permission_prompt.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/brain_reset_nudge.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/brain_reset_nudge.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/state_claim_check.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "worker|worker-strong",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/subagent_skill_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "mattpocock-skills@claude-plugins-official": false
  }
}
