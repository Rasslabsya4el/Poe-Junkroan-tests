{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "question": "deny",
    "doom_loop": "allow"
  },
  "provider": {
    "codex-sale-oai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "codex.sale",
      "options": {
        "baseURL": "https://codex.sale/v1",
        "apiKey": "{env:CODEX_LB_API_KEY}"
      },
      "models": {
        "gpt-5.6-terra": {
          "name": "GPT-5.6-Terra",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 400000,
            "output": 32000
          },
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 370000,
            "output": 32000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 300000,
            "output": 32000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
